/* ════════════════════════════════════════════
   裁剪页 — 像素风
   ════════════════════════════════════════════ */

.page {
  padding-bottom: 80rpx;
}

/* ── 上传区（选图阶段） ── */
.upload-zone {
  margin: 120rpx 40rpx 0;
  padding: 80rpx 40rpx;
  border-radius: 2rpx;
  text-align: center;
  background: var(--card);
  border: 3rpx dashed var(--border);
  box-shadow: var(--px-lg);
}
.upload-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.upload-text {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 700;
}
.upload-hint {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

/* ── 裁剪覆盖层 ── */
.crop-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1a1a1e;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: env(safe-area-inset-top);
}
.crop-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}
.crop-hint {
  color: #777;
  font-size: 22rpx;
  text-align: center;
  flex: 1;
}
.crop-skip, .crop-ok {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 2rpx;
  border: 2rpx solid;
}
.crop-skip {
  background: transparent;
  color: #999;
  border-color: rgba(255,255,255,0.12);
}
.crop-skip:active {
  background: rgba(255,255,255,0.05);
}
.crop-ok {
  background: var(--accent);
  color: #fff;
  border-color: rgba(0,0,0,0.12);
  box-shadow:
    2rpx 2rpx 0 rgba(0,0,0,0.2),
    inset 1rpx 1rpx 0 rgba(255,255,255,0.2);
}
.crop-ok:active {
  box-shadow: inset 2rpx 2rpx 0 rgba(0,0,0,0.15);
  transform: translate(1rpx, 1rpx);
}

/* ── 裁剪画布 ── */
.crop-stage {
  position: relative;
  margin-top: 20rpx;
  overflow: visible;
  background-color: #2a2a30;
  background-image:
    linear-gradient(45deg, #383840 25%, transparent 25%),
    linear-gradient(-45deg, #383840 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #383840 75%),
    linear-gradient(-45deg, transparent 75%, #383840 75%);
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0px;
  border-radius: 2rpx;
  border: 2rpx solid #444;
}
.crop-img {
  display: block;
  position: absolute;
}
.crop-frame {
  position: absolute;
  border: 3rpx dashed rgba(255,255,255,0.85);
  box-shadow: 0 0 0 4000rpx rgba(0,0,0,0.55);
}
.crop-handle {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  background: #fff;
  border: 3rpx solid var(--accent);
  border-radius: 2rpx;
  z-index: 10;
  box-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.3);
}
.crop-handle--tl {
  left: -16rpx;
  top: -16rpx;
}
.crop-handle--br {
  right: -16rpx;
  bottom: -16rpx;
}
.crop-grid-h {
  position: absolute;
  left: 0; right: 0;
  border-top: 2rpx solid rgba(255,255,255,0.2);
}
.crop-grid-v {
  position: absolute;
  top: 0; bottom: 0;
  border-left: 2rpx solid rgba(255,255,255,0.2);
}
