/* ════════════════════════════════════════════
   裁剪页 — 暖纸底 · 网页版对齐
   ════════════════════════════════════════════ */

.page {
  padding-bottom: 80rpx;
}

/* ── 上传区（选图阶段） ── */
.upload-zone {
  margin: 120rpx 40rpx 0;
  padding: 60rpx 40rpx;
  border-radius: 16rpx;
  text-align: center;
  background: var(--card);
  border: 2px dashed var(--border-strong);
  box-shadow: var(--shadow-card);
}
.upload-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.upload-text {
  font-size: 30rpx;
  color: #4a443c;
  font-weight: 700;
}
.upload-hint {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

/* ── 裁剪覆盖层 ── */
.crop-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1a1a1e;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: env(safe-area-inset-top);
}
.crop-top {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}
.crop-hint {
  color: #777;
  font-size: 22rpx;
  text-align: center;
  flex: 1;
}
.crop-skip, .crop-ok {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 10rpx;
  border: 1px solid;
}
.crop-skip {
  background: transparent;
  color: #999;
  border-color: rgba(255,255,255,.12);
}
.crop-skip:active {
  background: rgba(255,255,255,.05);
}
.crop-ok {
  background: var(--accent);
  color: #fff;
  border-color: rgba(0,0,0,0.08);
  box-shadow: 0 1px 2px rgba(224,90,43,.25);
}
.crop-ok:active {
  box-shadow: 0 1px 2px rgba(224,90,43,.35);
}

/* ── 比例预设按钮 ── */
.ratio-presets {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  flex-wrap: wrap;
}
.ratio-btn {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #999;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 8rpx;
  background: rgba(255,255,255,.06);
  letter-spacing: 0.5rpx;
  transition: all .12s;
}
.ratio-btn:active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
.ratio-btn--active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
  box-shadow: 0 0 0 2rpx rgba(224,90,43,.35);
}

/* ── 裁剪画布 ── */
.crop-stage {
  position: relative;
  margin-top: 20rpx;
  overflow: visible;
  background-color: #2a2a30;
  background-image:
    linear-gradient(45deg, #383840 25%, transparent 25%),
    linear-gradient(-45deg, #383840 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #383840 75%),
    linear-gradient(-45deg, transparent 75%, #383840 75%);
  background-size: 24rpx 24rpx;
  background-position: 0 0, 0 12rpx, 12rpx -12rpx, -12rpx 0px;
  border-radius: 6rpx;
  border: 2rpx solid #444;
}
.crop-img {
  display: block;
  position: absolute;
}
.crop-frame {
  position: absolute;
  border: 3rpx dashed rgba(255,255,255,0.85);
  box-shadow: 0 0 0 4000rpx rgba(0,0,0,0.55);
}
.crop-handle {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  background: #fff;
  border: 3rpx solid var(--accent);
  border-radius: 6rpx;
  z-index: 10;
  box-shadow: 0 2px 6px rgba(0,0,0,.3);
}
.crop-handle--tl {
  left: -16rpx;
  top: -16rpx;
}
.crop-handle--br {
  right: -16rpx;
  bottom: -16rpx;
}
.crop-grid-h {
  position: absolute;
  left: 0; right: 0;
  border-top: 2rpx solid rgba(255,255,255,0.2);
}
.crop-grid-v {
  position: absolute;
  top: 0; bottom: 0;
  border-left: 2rpx solid rgba(255,255,255,0.2);
}
