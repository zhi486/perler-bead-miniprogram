/* ════════════════════════════════════════════
   主页 — 像素风 / 拼豆既视感
   ════════════════════════════════════════════ */

.page {
  padding-bottom: 120rpx;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx 20rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 1rpx;
}
.nav-action {
  margin-left: auto;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  border-radius: 2rpx;
  box-shadow:
    2rpx 2rpx 0 rgba(91,140,90,0.15),
    inset 1rpx 1rpx 0 rgba(255,255,255,0.4);
}
.nav-action:active {
  box-shadow: inset 2rpx 2rpx 0 rgba(91,140,90,0.1);
  transform: translate(1rpx, 1rpx);
}

/* ── 上传区（无图片时） ── */
.upload {
  margin: 80rpx 40rpx 0;
  padding: 80rpx 40rpx;
  border-radius: 2rpx;
  text-align: center;
  background: var(--card);
  border: 3rpx dashed var(--border);
  box-shadow: var(--px-lg);
}
.upload-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}
.upload-text {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 700;
}
.upload-hint {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

/* ── 预览区 ── */
.preview {
  margin: 12rpx 24rpx;
  background: var(--card);
  border-radius: 2rpx;
  overflow: auto;
  min-height: 200rpx;
  text-align: center;
  border: 3rpx solid var(--border);
  box-shadow: var(--px-lg);
}
.preview-canvas {
  display: block;
  flex-shrink: 0;
}

/* ── 缩放栏 ── */
.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 0 0;
}
.zoom-btn {
  width: 52rpx;
  height: 44rpx;
  border-radius: 2rpx;
  background: var(--card);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  padding: 0;
  color: var(--text);
  border: 2rpx solid var(--border);
  box-shadow:
    2rpx 2rpx 0 rgba(0,0,0,0.06),
    inset 1rpx 1rpx 0 rgba(255,255,255,0.5);
}
.zoom-btn:active {
  background: var(--bg);
  box-shadow: inset 2rpx 2rpx 0 rgba(0,0,0,0.06);
  transform: translate(1rpx, 1rpx);
}
.zoom-reset {
  width: auto;
  padding: 0 16rpx;
  font-size: 24rpx;
}
.zoom-label {
  min-width: 68rpx;
  text-align: center;
  font-weight: 700;
  font-size: 24rpx;
  color: var(--text);
}

/* ── 信息行 ── */
.info-line {
  font-size: 24rpx;
  color: var(--sub);
  text-align: center;
  padding: 6rpx 24rpx;
}

/* ── 颜色图例 ── */
.legend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx 6rpx 6rpx;
  background: var(--bg);
  border-radius: 2rpx;
  border: 2rpx solid var(--border);
  min-width: 120rpx;
  box-shadow: 2rpx 2rpx 0 rgba(0,0,0,0.04);
}
.legend-chip__swatch {
  width: 30rpx;
  height: 22rpx;
  border-radius: 1rpx;
  flex-shrink: 0;
  /* 像一颗真实的拼豆：顶部高光 + 底部暗面 + 硬阴影 */
  box-shadow:
    inset 2rpx 2rpx 0 rgba(255,255,255,0.5),
    inset -1rpx -1rpx 0 rgba(0,0,0,0.1),
    1rpx 1rpx 0 rgba(0,0,0,0.12);
}
.legend-chip__code {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}
.legend-chip__count {
  font-size: 22rpx;
  color: var(--sub);
  margin-left: auto;
}
.legend-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--divider);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}
.legend-footer__rechoose {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 700;
}

/* ── 设置 ── */
.setting-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.setting-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  width: 72rpx;
  flex-shrink: 0;
}
.setting-slider {
  flex: 1;
}

.toggle-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 12rpx 0 0;
}
.toggle-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

/* ── 选择器 ── */
.selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 12rpx 16rpx;
  border: 2rpx solid var(--border);
  border-radius: 2rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--bg);
  box-shadow: inset 2rpx 2rpx 0 rgba(0,0,0,0.04);
}
.selector--sm {
  padding: 8rpx 12rpx;
  font-size: 24rpx;
}
.selector-arrow {
  font-size: 16rpx;
  color: var(--sub);
}

/* ── 导出 ── */
.export-area {
  padding: 16rpx 24rpx;
}
.export-btn {
  width: 100%;
  padding: 22rpx 0;
  border-radius: 2rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* ── 选择器浮层 ── */
.picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn .1s step-end;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.picker-menu {
  width: 560rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 2rpx;
  border: 3rpx solid var(--border);
  overflow-y: auto;
  padding: 4rpx 0;
  box-shadow:
    8rpx 8rpx 0 rgba(0,0,0,0.12);
}

.picker-head {
  padding: 16rpx 24rpx 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--sub);
  letter-spacing: 2rpx;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.picker-item:active {
  background: var(--bg);
}
.picker-item--sel {
  color: var(--accent);
}
.picker-check {
  color: var(--accent);
  font-weight: 700;
  font-size: 28rpx;
}
