/* ════════════════════════════════════════════
   主页 — 暖纸底 · 陶土橙 · 网页版对齐
   ════════════════════════════════════════════ */

/* ── Header：深色顶栏 + 彩虹条 ── */
.header {
  background: var(--header);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  height: 88rpx;
  box-sizing: border-box;
}
/* 3×3 拼豆 logo */
.logo {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.logo-dot {
  border-radius: 3rpx;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.brand h1 {
  color: #f7f3ec;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
.brand p {
  color: #a2988a;
  font-size: 20rpx;
  margin-top: 2rpx;
}
/* 彩虹渐变条 */
.rainbow-bar {
  height: 4rpx;
  background: linear-gradient(90deg,
    #f94144 0% 13%, #f8961e 13% 26%, #f9c74f 26% 39%,
    #90be6d 39% 51%, #43aa8b 51% 63%, #577590 63% 76%,
    #9b5de5 76% 88%, #f15bb5 88% 100%);
}
/* 裁剪入口 pill 按钮 */
.header-action {
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #cfc6b8;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}
.header-action:active {
  background: rgba(255,255,255,.08);
}

/* ── 上传区（无图片时） ── */
.upload {
  margin: 120rpx 40rpx 0;
  padding: 60rpx 40rpx;
  border-radius: 16rpx;
  text-align: center;
  background: var(--card);
  border: 2px dashed var(--border-strong);
  box-shadow: var(--shadow-card);
}
.upload-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 14rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.upload-icon-text {
  font-size: 34rpx;
}
.upload-text {
  font-size: 28rpx;
  color: #4a443c;
  font-weight: 600;
}
.upload-text .accent {
  color: var(--accent);
}
.upload-hint {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 8rpx;
}

/* ── 预览区 ── */
.preview-wrap {
  position: relative;
  margin: 12rpx 24rpx;
  background: var(--card);
  border-radius: 16rpx;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-card);
  overflow: auto;
  min-height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}
.preview-canvas {
  display: block;
  flex-shrink: 0;
  image-rendering: pixelated;
  background: #fff;
  border-radius: 4rpx;
  box-shadow: 0 0 0 1px var(--border);
}
/* 空状态占位 */
.preview-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--sub);
  pointer-events: none;
}
.preview-empty__icon {
  font-size: 48rpx;
  opacity: .5;
}
.preview-empty__title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.preview-empty__sub {
  font-size: 22rpx;
  opacity: .85;
}

/* ── 缩放工具栏 — 深色胶囊 ── */
.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: -6rpx 24rpx 0;
  background: rgba(35,31,26,.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-radius: 999rpx;
  padding: 6rpx 8rpx;
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
  box-shadow: 0 4px 14px rgba(28,25,23,.28);
}
.zoom-bar button {
  width: 52rpx;
  height: 44rpx;
  border: none;
  background: transparent;
  color: #f0eae0;
  font-size: 28rpx;
  line-height: 1;
  border-radius: 999rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.zoom-bar button:active {
  background: rgba(255,255,255,.15);
}
.zoom-bar button::after {
  border: none;
}
.zoom-label {
  color: #f0eae0;
  font-size: 24rpx;
  font-weight: 600;
  min-width: 68rpx;
  text-align: center;
}
.dock-sep {
  width: 1px;
  height: 24rpx;
  background: rgba(255,255,255,.2);
  margin: 0 8rpx;
}

/* ── 状态栏 ── */
.statusbar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 2rpx 36rpx;
  margin-bottom: 6rpx;
}
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #57a773;
  box-shadow: 0 0 0 5rpx rgba(87,167,115,.15);
  flex-shrink: 0;
}
.status-text {
  font-size: 24rpx;
  color: var(--sub);
}

/* ── 颜色图例 ── */
.legend-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.legend-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx 6rpx 8rpx;
  background: var(--bg);
  border-radius: 8rpx;
  border: 1px solid var(--border);
  min-width: 130rpx;
  box-shadow: 0 1px 1px rgba(0,0,0,.03);
}
.legend-chip__swatch {
  width: 32rpx;
  height: 24rpx;
  border-radius: 5rpx;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1px rgba(0,0,0,.09);
}
.legend-chip__code {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}
.legend-chip__count {
  font-size: 22rpx;
  color: var(--sub);
  margin-left: auto;
}
.legend-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1px solid var(--divider);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}
.legend-footer__rechoose {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 700;
}

/* ── 设置 ── */
.setting-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.setting-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #453f37;
  width: 80rpx;
  flex-shrink: 0;
}
.setting-slider {
  flex: 1;
}

.toggle-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 14rpx 0 0;
}
.toggle-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #453f37;
}

/* ── 选择器 ── */
.selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 14rpx 18rpx;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #fff;
  transition: border-color .15s;
}
.selector--sm {
  padding: 10rpx 14rpx;
  font-size: 24rpx;
}
.selector-arrow {
  font-size: 16rpx;
  color: var(--sub);
}

/* ── 导出 ── */
.export-area {
  padding: 16rpx 24rpx;
}
.export-btn {
  width: 100%;
  padding: 22rpx 0;
  border-radius: 10rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

/* ── 选择器浮层 ── */
.picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn .1s step-end;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.picker-menu {
  width: 580rpx;
  max-height: 70vh;
  background: #fff;
  border-radius: 16rpx;
  overflow-y: auto;
  padding: 6rpx 0;
  box-shadow: var(--shadow-popup);
}

.picker-head {
  padding: 18rpx 28rpx 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--sub);
  letter-spacing: 2rpx;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}
.picker-item:active {
  background: var(--bg);
}
.picker-item--sel {
  color: var(--accent);
  font-weight: 600;
}
.picker-check {
  color: var(--accent);
  font-weight: 700;
  font-size: 28rpx;
}

/* ── 材质选择器描述 ── */
.picker-item__labeled {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.picker-item__desc {
  font-size: 22rpx;
  color: var(--sub);
  font-weight: 400;
}

/* ── 材质半透明提示 ── */
.material-note {
  padding: 10rpx 18rpx;
  margin: 6rpx 0 10rpx;
  background: #fdf6e3;
  border: 1px solid #eed9a0;
  border-left: 4rpx solid #e0b93e;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #8a6d14;
  line-height: 1.55;
  font-weight: 500;
}
